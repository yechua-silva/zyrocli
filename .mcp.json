{
  "mcpServers": {
    "go-quality": {
      "command": "mcp-server-go-quality",
      "args": []
    },
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "/home/secko/Projects/ZyroAgentCLI"
      ]
    },
    "github": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server",
        "--read-only",
        "--toolsets",
        "repos,issues,pull_requests"
      ]
    },
    "zyro-embeddings": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "/home/secko/Projects/ZyroAgentCLI/mcp-tools",
        "python",
        "embedding_harness.py"
      ]
    }
  }
}
